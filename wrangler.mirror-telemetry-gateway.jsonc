{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "youtube-mirror-telemetry-gateway",
	"main": "worker/telemetry-gateway.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true
	// scripts/render-deploy-configs.ts adds the selected environment's account,
	// Azure/OIDC vars and Secrets Store signing-key binding. INGEST_BEARER is
	// uploaded separately as a classic Worker secret before this worker deploys.
}
