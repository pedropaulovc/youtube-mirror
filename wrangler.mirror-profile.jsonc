{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "youtube-mirror-profile",
	"main": "worker/mirror-profile.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": false,
			"invocation_logs": true,
			"destinations": ["youtube-azure-logs"]
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": false,
			"destinations": ["youtube-azure-traces"]
		}
	},
	"workflows": [
		{
			"name": "youtube-mirror-profile",
			"binding": "PROFILE_SYNC_WORKFLOW",
			"class_name": "MirrorProfileWorkflow"
		}
	],
	"upload_source_maps": true
	// scripts/render-deploy-configs.ts adds the selected environment's account,
	// schedule, vars, KV namespace, and Secrets Store bindings.
}
